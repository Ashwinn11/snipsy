    "Or just swipe on — you can add photos\nfrom your library any time.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder wisch weiter — du kannst jederzeit\nFotos aus der Mediathek hinzufügen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "O pasa: puedes añadir fotos\ndesde tu galería cuando quieras."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "O pasa: puedes añadir fotos\ndesde tu galería cuando quieras."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou passez — vous pourrez ajouter des photos\ndepuis votre galerie quand vous voulez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure vai avanti — puoi aggiungere foto\ndalla libreria quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま進んでも大丈夫。写真は\nいつでもライブラリから追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그냥 넘겨도 괜찮아요. 앨범에서\n언제든 사진을 추가할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou siga — dá para adicionar fotos\nda galeria quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или листайте дальше — фото можно\nдобавить из галереи в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者直接往后滑——你随时可以\n从相册添加照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或者直接往後滑——你隨時可以\n從相簿新增照片。"
          }
        }
      }
    },
