    "Pay once. Yours forever.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal zahlen. Für immer deins."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga una vez. Tuyo para siempre."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga una vez. Tuyo para siempre."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez une fois. C'est à vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paghi una volta. Tuo per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度のお支払いで、ずっと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 결제. 평생 소장."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague uma vez. Seu para sempre."
          }
