          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每張郵票都只存在這臺裝置上。"
          }
        }
      }
    },
    "Every stamp starts with a photo.\nAllow camera access in Settings.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Marke beginnt mit einem Foto.\nErlaube die Kamera in den Einstellungen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sello empieza con una foto.\nPermite la cámara en Ajustes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sello empieza con una foto.\nPermite la cámara en Configuración."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque timbre commence par une photo.\nAutorisez l'appareil photo dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni francobollo nasce da una foto.\nAutorizza la fotocamera in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切手は写真から始まります。\n設定でカメラを許可してください。"
          }
