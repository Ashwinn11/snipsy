            "state": "translated",
            "value": "一次性"
          }
        }
      }
    },
    "One a day —\nnot one of ten thousand.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine pro Tag —\nnicht eine von zehntausend."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno al día,\nno uno entre diez mil."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno al día,\nno uno entre diez mil."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par jour —\npas un parmi dix mille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno al giorno —\nnon uno su diecimila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日に一枚。\n一万枚のうちの一枚ではなく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 하나 —\n만 장 중 하나가 아니라."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um por dia —\nnão um entre dez mil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна в день —\nа не одна из десяти тысяч."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一天一张——\n而不是一万张里的一张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一天一張——\n而不是一萬張裡的一張。"
          }
        }
      }
    },
    "One after every day worth it.\nBy next year, a shelf of them.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine nach jedem Tag, der zählt.\nNächstes Jahr ein ganzes Regal."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno por cada día que valga la pena.\nEn un año, una estantería llena."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno por cada día que valga la pena.\nEn un año, una estantería llena."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un après chaque jour qui compte.\nDans un an, toute une étagère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno dopo ogni giorno che conta.\nTra un anno, uno scaffale pieno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残したい日ごとに一枚。\n一年後には棚いっぱいに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억할 만한 날마다 한 장씩.\n내년이면 한 선반 가득."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um depois de cada dia que vale.\nNo ano que vem, uma prateleira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одной после каждого стоящего дня.\nЧерез год — целая полка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个值得的日子留一张。\n到明年，就是满满一架。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個值得的日子留一張。\n到明年，就是滿滿一架。"
          }
        }
      }
    },
    "One look for the batch — you can change any of them later.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Look für alle — später einzeln änderbar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un estilo para todas: puedes cambiarlas después."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un estilo para todas: puedes cambiarlas después."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rendu pour le lot — modifiable ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno stile per tutte — puoi cambiarle dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとめて同じ仕上げに。あとから個別に変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체에 같은 스타일로. 나중에 하나씩 바꿀 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um estilo para todas — dá para mudar depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один стиль на всю партию — потом можно изменить любую."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整批用同一种效果——之后可以单独修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整批用同一種效果——之後可以單獨修改。"
          }
        }
      }
    },
