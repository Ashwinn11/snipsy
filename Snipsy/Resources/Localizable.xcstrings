          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая марка начинается с фото.\nРазрешите доступ к камере в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
