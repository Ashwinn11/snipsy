            "state": "translated",
            "value": "一次付費，永久擁有。"
          }
        }
      }
    },
    "Photos pile up.\nNone of them get kept.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos sammeln sich an.\nKeines wird aufgehoben."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se acumulan.\nNinguna se guarda."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se acumulan.\nNinguna se guarda."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos s'accumulent.\nAucune n'est gardée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto si accumulano.\nNessuna viene conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は溜まるばかり。\n何も残らない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 쌓이기만 하고\n남는 건 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
