          }
        }
      }
    },
    "Every stamp starts with a photo.\nNothing leaves your device.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Marke beginnt mit einem Foto.\nNichts verlässt dein Gerät."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sello empieza con una foto.\nNada sale de tu dispositivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sello empieza con una foto.\nNada sale de tu dispositivo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque timbre commence par une photo.\nRien ne quitte votre appareil."
          }
        },
        "it": {
