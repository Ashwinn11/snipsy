{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    "%@\nWatch it get cut out and kept.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nSieh zu, wie es freigestellt und behalten wird."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nMíralo recortarse y quedarse."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nMíralo recortarse y quedarse."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nRegardez-le se détourer et rester."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nGuardala ritagliarsi e restare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n切り抜かれて残る様子を見てみて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n오려져서 남는 걸 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nVeja recortar e ficar guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nСмотрите, как это вырезается и остаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n看它被抠出来、留下来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n看它被摳出來、留下來。"
          }
        }
      }
    },
