    "Snap anything. Watch it get cut out\nand pressed into a stamp.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere irgendwas. Sieh zu, wie es\nfreigestellt und zur Marke gepresst wird."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía lo que sea. Míralo recortarse\ny convertirse en un sello."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía lo que sea. Míralo recortarse\ny convertirse en un sello."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez ce que vous voulez. Regardez-le\nse détourer et devenir un timbre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografa qualsiasi cosa. Guardala ritagliarsi\ne diventare un francobollo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何でも撮ってみて。切り抜かれて\n切手になる様子を見てみて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무거나 찍어보세요. 오려져서\n우표가 되는 걸 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe qualquer coisa. Veja recortar\ne virar um selo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимите что угодно. Смотрите, как это\nвырезается и превращается в марку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随便拍点什么。看它被抠出来，\n压成一张邮票。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨便拍點什麼。看它被摳出來，\n壓成一張郵票。"
          }
        }
      }
    },
