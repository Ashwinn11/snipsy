    "Any photo you already have\ncan become the next one.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Foto, das du schon hast,\nkann das nächste werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier foto que ya tengas\npuede ser la siguiente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier foto que ya tengas\npuede ser la siguiente."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe quelle photo que vous avez\npeut devenir la prochaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi foto che hai già\npuò diventare la prossima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手元にある写真が\n次の一枚になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 가지고 있는 사진도\n다음 한 장이 될 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer foto que você já tem\npode ser a próxima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любое фото, которое у вас есть,\nможет стать следующим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你手机里任何一张照片\n都能变成下一张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你手機裡任何一張照片\n都能變成下一張。"
          }
        }
      }
    },
    "Anything in the photo gets lifted out…": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles auf dem Foto wird freigestellt…"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de la foto se recorta…"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de la foto se recorta…"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est sur la photo est détouré…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è nella foto viene ritagliato…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の中のものを切り抜きます…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 속 무엇이든 오려내요…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo na foto é recortado…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё что угодно вырезается с фото…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片里的任何东西都能抠出来…"
          }
