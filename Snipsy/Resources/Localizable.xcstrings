    "Every stamp lives only on this device.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Marke bleibt nur auf diesem Gerät."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sello vive solo en este dispositivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sello vive solo en este dispositivo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque timbre reste sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni francobollo resta su questo dispositivo."
          }
        },
