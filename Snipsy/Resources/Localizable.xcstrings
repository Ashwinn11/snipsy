    "A real object,\nwithout the printer.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein echtes Objekt,\nohne Drucker."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo real,\nsin impresora."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo real,\nsin impresora."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objet réel,\nsans imprimante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un oggetto vero,\nsenza stampante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリンターなしで\n本物のモノに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터 없이도\n진짜 물건처럼."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo real,\nsem impressora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настоящая вещь —\nбез принтера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用打印机，\n也是实实在在的东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用印表機，\n也是實實在在的東西。"
          }
        }
      }
    },
