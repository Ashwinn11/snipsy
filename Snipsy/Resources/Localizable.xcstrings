    "Nothing collected yet — take a photo and it'll show up here.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts gesammelt — mach ein Foto, dann erscheint es hier."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada todavía: haz una foto y aparecerá aquí."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aún: toma una foto y aparecerá aquí."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant — prenez une photo, elle apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente — scatta una foto e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もありません。写真を撮るとここに出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 모은 게 없어요. 사진을 찍으면 여기에 나타나요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ainda — tire uma foto e ela aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока пусто — сделайте фото, и оно появится здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有收藏——拍张照片，它就会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有收藏——拍張照片，它就會出現在這裡。"
          }
        }
      }
    },
    "Nothing leaves your device.": {
      "localizations": {
