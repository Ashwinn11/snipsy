    "Tell us once, and the rest of this\nis about yours.": {
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag es einmal, und alles Weitere\nhandelt von deinen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Dínoslo una vez y todo lo demás\nserá sobre los tuyos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Dínoslo una vez y todo lo demás\nserá sobre los tuyos."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-le une fois, et tout le reste\nparlera des vôtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diccelo una volta, e tutto il resto\nparlerà dei tuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけ教えて。\nあとはぜんぶあなたの話です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 알려주면\n나머지는 당신 이야기예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte uma vez, e todo o resto\nfala das suas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите один раз — и всё остальное\nбудет про ваши."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我们一次，剩下的\n都是关于你的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴我們一次，剩下的\n都是關於你的。"
          }
        }
      }
    },
